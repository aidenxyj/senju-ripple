# Copy to .env.server in the project folder (it is git-ignored) and fill in.
# Supabase dashboard > Settings > API Keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_...). Safe to send to browsers.
SUPABASE_PUBLISHABLE_KEY=...
# The secret key (sb_secret_...). Server only. Never commit it.
SUPABASE_SECRET_KEY=...
# Encrypts people's Ripple API keys in the database. Generate once: openssl rand -hex 32
# Keep it forever: changing it makes every stored key unreadable.
KEY_ENCRYPTION_SECRET=...
PORT=8787

# ---- Hosted sessions (optional) ----
# With these set, people without their own Ripple API key can subscribe and run on this key.
# Leave them out and everyone brings their own key, as before.
# RIPPLE_BASE_URL=http://<vast-ip>:<port>/v1   # the hub's own Vast B200 (tools/vast/)
# RIPPLE_API_KEY=...                           # that B200's vLLM server key
# Stripe dashboard > Developers > API keys. Use the sk_test_ key until you are ready to charge.
# STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or from the webhook endpoint you add in the Stripe dashboard.
# STRIPE_WEBHOOK_SECRET=whsec_...
# This server's public address. Stripe sends people back here after paying.
# PUBLIC_URL=https://senju-ripple-hub.fly.dev
# Pricing, all optional. Defaults: $20 a month including $20 of credits, credits spent at cost x 1.3.
# SENJU_PLAN_USD=20
# SENJU_PLAN_CREDITS_USD=20
# SENJU_TOPUPS_USD=10,25,50
# SENJU_MARKUP=1.3
