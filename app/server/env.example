# Copy to .env.server in the project folder (it is git-ignored) and fill in.
# Supabase dashboard > Settings > API Keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_...). Safe to send to browsers.
SUPABASE_PUBLISHABLE_KEY=...
# The secret key (sb_secret_...). Server only. Never commit it.
SUPABASE_SECRET_KEY=...
# Encrypts people's saved model settings (including their API keys) in the database. Generate once: openssl rand -hex 32
# Keep it forever: changing it makes every stored key unreadable.
KEY_ENCRYPTION_SECRET=...
PORT=8787

# ---- People's own models ----
# Each person saves a base URL, a model name and (if the endpoint needs one) an API key in the web app, for any
# OpenAI-compatible chat completions endpoint, hosted or self-run. Sessions they start run on it. Nothing to set here.

# ---- Server model and paid sessions (optional) ----
# With LLM_BASE_URL and LLM_MODEL set (and Stripe below), people without their own model settings can subscribe and
# run sessions on this model, paying in credits. Leave them out and everyone brings their own model.
# LLM_BASE_URL=https://<host>/v1                # the base URL of any OpenAI-compatible endpoint
# LLM_MODEL=<model>                             # the model name that endpoint expects
# LLM_API_KEY=...                               # optional: only if the endpoint needs a key
# LLM_MAX_CONTEXT=128000                        # optional: tokens the endpoint accepts
# LLM_VISION=1                                  # optional: the model reads screenshots
# Stripe dashboard > Developers > API keys. Use the sk_test_ key until you are ready to charge.
# STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or from the webhook endpoint you add in the Stripe dashboard.
# STRIPE_WEBHOOK_SECRET=whsec_...
# This server's public address. Stripe sends people back here after paying.
# PUBLIC_URL=https://your-hub.example.com
# Pricing, all optional. Defaults: $20 a month including $20 of credits, credits spent at cost x 1.3.
# SENJU_PLAN_USD=20
# SENJU_PLAN_CREDITS_USD=20
# SENJU_TOPUPS_USD=10,25,50
# SENJU_MARKUP=1.3
# SENJU_MIN_START_USD=0.5                       # the balance a session needs to start
# What the server model costs you, in dollars per million tokens (placeholders: set your provider's prices,
# or for a server rented by the hour, your hourly cost spread over your traffic).
# SENJU_RATE_INPUT=0.1
# SENJU_RATE_OUTPUT=0.3
# SENJU_RATE_CACHE_READ=0.1
# SENJU_RATE_CACHE_WRITE=0.1
