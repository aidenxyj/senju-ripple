# Copy to .env (git-ignored) and fill in. Ripple runs on a Vast.ai B200 you rent (see tools/vast/README.md).
# RIPPLE_BASE_URL is filled in by `python3 tools/vast/ripple_b200.py env <instance>` once the B200 is up.
RIPPLE_BASE_URL=http://<vast-ip>:<port>/v1
# Any long random string, e.g. `openssl rand -hex 24`. The B200's vLLM server only accepts this key.
RIPPLE_API_KEY=
RIPPLE_MODEL=ricursiveai/ripple-65b-preview
RIPPLE_MAX_CONTEXT=131072    # vLLM's --max-model-len on the B200
