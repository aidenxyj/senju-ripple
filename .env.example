# Copy to .env (git-ignored) and fill in. Senju works with any OpenAI-compatible chat completions endpoint:
# a hosted API or a server you run yourself. You need its base URL (usually ending in /v1), the model name it
# expects, and an API key if it asks for one.
# Self-hosting on a rented GPU: see tools/README.md.
LLM_BASE_URL=
LLM_MODEL=
# Leave empty for a local server that takes no key.
LLM_API_KEY=
# Optional: the endpoint's context limit in tokens, so too-long requests fail fast instead of erroring.
# LLM_MAX_CONTEXT=131072
# Optional: 1 sends images in tool results to the model (vision models). Off: each image becomes "[image omitted]".
# LLM_VISION=0
